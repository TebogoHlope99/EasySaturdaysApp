<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:background="@color/primary" android:gravity="center_vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EasySaturdays" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold"/>
        </LinearLayout>

        <!-- Hero Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/primary"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Empowering Tembisa Together"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Join The Easy Saturdays Foundation in driving social upliftment through community support, education, and youth empowerment in Ekurhuleni."
                android:textColor="#E2E8F0"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginTop="16dp"/>

            <Button
                android:id="@+id/btnViewCampaigns"
                android:layout_width="220dp"
                android:layout_height="50dp"
                android:layout_marginTop="32dp"
                android:text="View Campaigns"
                android:backgroundTint="@color/secondary"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="25dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"/>

            <Button
                android:id="@+id/btnLoginRegister"
                android:layout_width="220dp"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="Login / Register"
                android:backgroundTint="@color/white"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="25dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"/>
        </LinearLayout>

        <!-- Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="© 2026 The Easy Saturdays Foundation. All rights reserved."
                android:textColor="#E2E8F0"
                android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>