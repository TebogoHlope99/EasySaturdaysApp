<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8FAFC">

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="👑 Super Admin Control Center"
        android:textSize="22sp" android:textStyle="bold" android:textColor="#1E3A8A"
        android:padding="16dp"/>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/superAdminTabLayout"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#1E3A8A"
        app:tabTextColor="#FFFFFF" app:tabSelectedTextColor="#F59E0B" app:tabIndicatorColor="#F59E0B"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/superAdminViewPager"
        android:layout_width="match_parent" android:layout_height="match_parent"/>
</LinearLayout>